{
  "name": "Contoso.Scanner",
  "id": "7a87f315-4b5e-40a2-b748-b0cdd8adab41",
  "packageVersion": "1.0.0",
  "defaultCulture": "en-US",
  "displayNames": {
    "en-US": "Contoso Scanner"
  },
  "descriptions": {
    "en-US": "Structured events produced by Contoso Scanner."
  },
