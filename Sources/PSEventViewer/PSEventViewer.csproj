<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;netstandard2.1;net8.0-windows;net10.0-windows</TargetFrameworks>
        <Description>Thin compiled PowerShell commands over the EventViewerX Windows Event Log engine.</Description>
        <AssemblyName>PSEventViewer</AssemblyName>
        <AssemblyTitle>PSEventViewer</AssemblyTitle>
        <VersionPrefix>4.0.0</VersionPrefix>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <Company>Evotec</Company>
        <Authors>Przemyslaw Klys</Authors>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsWindows>true</IsWindows>
        <SupportedOSPlatform>windows</SupportedOSPlatform>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="PowerShellStandard.Library" Version="5.1.1" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
        <!-- A netstandard publish selects portable Windows API facades and omits RID
             assets. Keep their package roots available to stage a real PS 7 payload. -->
        <PackageReference Include="System.Diagnostics.EventLog" Version="6.0.0"
                          GeneratePathProperty="true" PrivateAssets="all" />
        <PackageReference Include="System.DirectoryServices" Version="6.0.0"
                          GeneratePathProperty="true" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0"
                          GeneratePathProperty="true" PrivateAssets="all" />
        <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0"
                          GeneratePathProperty="true" PrivateAssets="all" />
        <PackageReference Include="System.Security.AccessControl" Version="6.0.0"
                          GeneratePathProperty="true" PrivateAssets="all" />
        <PackageReference Include="System.Security.Principal.Windows" Version="5.0.0"
                          GeneratePathProperty="true" PrivateAssets="all" />
        <PackageReference Include="SQLite" Version="3.53.4"
                          GeneratePathProperty="true" PrivateAssets="all" />
    </ItemGroup>
  <ItemGroup>
      <ProjectReference Include="..\EventViewerX\EventViewerX.csproj" />
      <ProjectReference Include="..\EventViewerX.Detection\EventViewerX.Detection.csproj" />
      <ProjectReference Include="..\EventViewerX.Evtx\EventViewerX.Evtx.csproj" />
      <ProjectReference Include="..\EventViewerX.Reporting\EventViewerX.Reporting.csproj" />
      <ProjectReference Include="..\EventViewerX.Storage\EventViewerX.Storage.csproj" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
      <PackageReference Include="System.Text.Json" Version="10.0.11" />
      <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
      <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
      <!-- System.Data.SQLite's .NET Framework build is native-platform specific. PowerShell 7 uses the architecture-neutral netstandard payload below. -->
      <RuntimeIdentifier>win-x64</RuntimeIdentifier>
      <PlatformTarget>x64</PlatformTarget>
      <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
    <!-- Make sure the output DLL's from library are included in the output -->
    <PropertyGroup>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="System.Collections" />
        <Using Include="System.Management.Automation" />
        <Using Include="System.Threading.Tasks" />
        <Using Include="System.Collections.Concurrent" />
        <Using Include="System.Threading" />
        <Using Include="System" />
        <Using Include="System.Collections.Generic" />
        <Using Include="System.Linq" />
        <Using Include="System.Text" />
        <Using Include="System.IO" />
        <Using Include="System.Net" />
        <Using Include="System.Diagnostics" />
        <Using Include="EventViewerX" />
        <Using Include="EventViewerX.Sigma" />
        <Using Include="EventViewerX.Evtx" />
        <Using Include="EventViewerX.Reporting" />
        <Using Include="EventViewerX.Storage" />
    </ItemGroup>

    <!-- We need to remove PowerShell conflicting libraries as it will break output -->
    <Target Name="RemoveFilesAfterBuild" AfterTargets="Build">
        <Delete Files="$(OutDir)System.Management.Automation.dll"
                Condition="Exists('$(OutDir)System.Management.Automation.dll')" />
        <Delete Files="$(OutDir)System.Management.dll"
                Condition="Exists('$(OutDir)System.Management.dll')" />
    </Target>

    <Target Name="StagePowerShellCoreWindowsRuntimeAssets" AfterTargets="Publish"
            Condition="'$(TargetFramework)' == 'netstandard2.1'">
        <ItemGroup>
            <PowerShellCoreWindowsRuntime Include="$(PkgSystem_Diagnostics_EventLog)\runtimes\win\lib\netcoreapp3.1\System.Diagnostics.EventLog*.dll" />
            <PowerShellCoreWindowsRuntime Include="$(PkgSystem_DirectoryServices)\runtimes\win\lib\netcoreapp3.1\System.DirectoryServices.dll" />
            <PowerShellCoreWindowsRuntime Include="$(PkgMicrosoft_Win32_Registry)\runtimes\win\lib\netstandard2.0\Microsoft.Win32.Registry.dll" />
            <PowerShellCoreWindowsRuntime Include="$(PkgSystem_IO_FileSystem_AccessControl)\runtimes\win\lib\netstandard2.0\System.IO.FileSystem.AccessControl.dll" />
            <PowerShellCoreWindowsRuntime Include="$(PkgSystem_Security_AccessControl)\runtimes\win\lib\netstandard2.0\System.Security.AccessControl.dll" />
            <PowerShellCoreWindowsRuntime Include="$(PkgSystem_Security_Principal_Windows)\runtimes\win\lib\netcoreapp2.1\System.Security.Principal.Windows.dll" />
            <PowerShellCoreNativeRuntime Include="$(PkgSQLite)\runtimes\win-x64\native\e_sqlite3.dll">
                <DestinationSubDirectory>runtimes\win-x64\native</DestinationSubDirectory>
            </PowerShellCoreNativeRuntime>
            <PowerShellCoreNativeRuntime Include="$(PkgSQLite)\runtimes\win-x86\native\e_sqlite3.dll">
                <DestinationSubDirectory>runtimes\win-x86\native</DestinationSubDirectory>
            </PowerShellCoreNativeRuntime>
            <PowerShellCoreNativeRuntime Include="$(PkgSQLite)\runtimes\win-arm64\native\e_sqlite3.dll">
                <DestinationSubDirectory>runtimes\win-arm64\native</DestinationSubDirectory>
            </PowerShellCoreNativeRuntime>
        </ItemGroup>
        <Error Condition="'@(PowerShellCoreWindowsRuntime)' == '' Or '@(PowerShellCoreNativeRuntime)' == ''"
               Text="The PowerShell 7 Windows runtime payload could not be resolved from its pinned packages." />
        <Copy SourceFiles="@(PowerShellCoreWindowsRuntime)" DestinationFolder="$(PublishDir)" />
        <Copy SourceFiles="@(PowerShellCoreNativeRuntime)"
              DestinationFiles="@(PowerShellCoreNativeRuntime->'$(PublishDir)%(DestinationSubDirectory)\%(Filename)%(Extension)')" />
    </Target>

    <PropertyGroup>
        <!-- PowerForge enriches module help from the compiler XML documentation file. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
</Project>
